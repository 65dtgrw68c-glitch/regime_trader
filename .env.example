# Copy this file to .env and fill in your real credentials.
# Never commit .env to version control.
#
# No inline comments on the lines below: python-dotenv (local/dev) and
# systemd's EnvironmentFile= (server) parse them differently, and a comment
# tacked onto PAPER=true has flipped it to live trading before. Put any
# comment on its own line instead.

ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# true = paper trading, false = LIVE (real money). Must also match
# settings/config.py's BROKER["mode"] — the bot refuses to start otherwise.
PAPER=true

# Optional — alerts (order rejections, API outages, halts, drift, ...).
# Leave unset and nothing is sent; both channels are otherwise on by
# default (settings/config.py ALERTS["email_enabled"/"webhook_enabled"]).
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...   (or Slack)
# ALERT_EMAIL_RECIPIENTS=ops@example.com,you@example.com
